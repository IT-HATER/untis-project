# Copy this file to .env and fill it in:  cp .env.example .env
# .env is in .gitignore - never commit your real login.

# WebUntis server, without https:// (e.g. xyz.webuntis.com)
UNTIS_SERVER=
# School login name (login page URL shows ?school=XXXX)
UNTIS_SCHOOL=
# Needs an account that may see ALL classes (teacher/admin/school display account)
UNTIS_USER=
UNTIS_PASSWORD=
